# =============================================================================
# WRINDHAOS PRODUCTION BACKEND CONFIGURATION
# =============================================================================

# Server Environment
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
JWT_SECRET=wrindhaos_super_secret_jwt_key_2026_prod

# -----------------------------------------------------------------------------
# 1. MSG91 (Email OTP & SMS Verification)
# -----------------------------------------------------------------------------
MSG91_AUTH_KEY=your_msg91_authkey_here
MSG91_EMAIL_TEMPLATE_ID=your_msg91_email_template_id_here
MSG91_EMAIL_FROM=no-reply@wrindhaos.com
MSG91_DOMAIN=wrindhaos.com
MSG91_OTP_TEMPLATE_ID=your_msg91_sms_template_id_here
MSG91_SENDER_ID=WRNDHA

# -----------------------------------------------------------------------------
# 2. GOOGLE SIGN-IN (OAuth2 / Identity)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# -----------------------------------------------------------------------------
# 3. GOOGLE PLAY BILLING (₹49/month Pro In-App Subscriptions)
# -----------------------------------------------------------------------------
GOOGLE_PLAY_PACKAGE_NAME=com.wrindhaos.productivity
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=pro_monthly_49
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=wrindhaos-billing@your-project.iam.gserviceaccount.com
GOOGLE_PLAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# -----------------------------------------------------------------------------
# 4. FIREBASE CLOUD MESSAGING (FCM Push Notifications)
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=your_firebase_project_id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# -----------------------------------------------------------------------------
# 5. SUPABASE / POSTGRESQL (Cloud Database)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
